<Window x:Class="CodexTempo.CloseChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关闭 Codex Tempo" Width="366" Height="196"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="Muted" Color="#6E6E73"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#E5E5EA"/>
    <SolidColorBrush x:Key="Accent" Color="#007AFF"/>
    <DropShadowEffect x:Key="DialogShadow" BlurRadius="24" ShadowDepth="6" Opacity=".18" Color="#1D1D1F"/>
    <Style x:Key="ChoiceButton" TargetType="Button">
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonShell" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonShell" Property="Opacity" Value=".88"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonShell" Property="Opacity" Value=".72"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Margin="14" Padding="22,19" CornerRadius="18"
          Background="{DynamicResource PanelBackground}"
          BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
          Effect="{StaticResource DialogShadow}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <TextBlock Text="要把 Codex Tempo 放到哪里？" FontSize="17" FontWeight="SemiBold"
                 Foreground="{DynamicResource Ink}"/>
      <TextBlock Grid.Row="1" Margin="0,8,0,0"
                 Text="隐藏后仍会在托盘运行，双击托盘图标即可恢复。"
                 FontSize="11" Foreground="{DynamicResource Muted}"/>
      <Grid Grid.Row="2" Margin="0,18,0,0" VerticalAlignment="Bottom">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button Style="{StaticResource ChoiceButton}" Background="{DynamicResource Accent}"
                Foreground="White" Content="隐藏到托盘" Click="HideButton_Click"/>
        <Button Grid.Column="2" Style="{StaticResource ChoiceButton}"
                Background="{DynamicResource CardBackground}" Foreground="{DynamicResource Ink}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
                Content="退出程序" Click="ExitButton_Click"/>
      </Grid>
    </Grid>
  </Border>
</Window>
