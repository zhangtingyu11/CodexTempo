<Window x:Class="CodexTempo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Tempo" Width="420" Height="340"
        MinWidth="144" MinHeight="56"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
        SnapsToDevicePixels="True"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        MouseDoubleClick="Window_MouseDoubleClick">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#1D1D1F"/>
    <SolidColorBrush x:Key="Muted" Color="#6E6E73"/>
    <SolidColorBrush x:Key="Hairline" Color="#E5E5EA"/>
    <SolidColorBrush x:Key="Accent" Color="#007AFF"/>
    <SolidColorBrush x:Key="Track" Color="#E5E5EA"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#E5E5EA"/>
    <SolidColorBrush x:Key="ChromeHover" Color="#12000000"/>
    <SolidColorBrush x:Key="ChromePressed" Color="#22000000"/>
    <SolidColorBrush x:Key="FooterMuted" Color="#8E8E93"/>
    <DropShadowEffect x:Key="SoftShadow" BlurRadius="24" ShadowDepth="6" Opacity=".16" Color="#1D1D1F"/>

    <Style x:Key="ChromeButton" TargetType="Button">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Margin" Value="3,0,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Shell" Background="{TemplateBinding Background}" CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource ChromeHover}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource ChromePressed}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ThinProgress" TargetType="ProgressBar">
      <Setter Property="Height" Value="5"/>
      <Setter Property="Background" Value="{DynamicResource Track}"/>
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
              <Grid x:Name="PART_Track" ClipToBounds="True">
                <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                        Background="{TemplateBinding Foreground}" CornerRadius="3"/>
              </Grid>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="WidgetShell" Margin="12" CornerRadius="18"
          Background="{DynamicResource PanelBackground}"
          BorderBrush="{DynamicResource CardBorder}" BorderThickness="1"
          Effect="{StaticResource SoftShadow}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition x:Name="HeaderRow" Height="54"/>
        <RowDefinition x:Name="AdviceRow" Height="76"/>
        <RowDefinition x:Name="LimitsRow" Height="142"/>
        <RowDefinition x:Name="FooterRow" Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="20,12,12,0" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="Assets/AppIcon.png" Width="28" Height="28" Margin="0,0,9,0"
                 Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Text="Codex Tempo" FontSize="13" FontWeight="SemiBold"
                     Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="PinButton" Style="{StaticResource ChromeButton}" Content="&#xE840;"
                  ToolTip="已置顶，点击取消" Click="PinButton_Click"/>
          <Button Style="{StaticResource ChromeButton}" Content="&#xE921;"
                  ToolTip="收起到屏幕边缘" Click="MinimizeButton_Click"/>
          <Button Style="{StaticResource ChromeButton}" Content="&#xE8BB;"
                  ToolTip="隐藏或退出" Click="CloseButton_Click"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="20,6,20,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="AdviceTitle" Text="正在读取额度" FontSize="26" FontWeight="SemiBold"
                   Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
        <Border Grid.Column="1" x:Name="RatePill" CornerRadius="13"
                Background="{DynamicResource CardBackground}"
                Padding="10,5" VerticalAlignment="Center" Margin="12,0,0,0">
          <TextBlock x:Name="RateLabel" Text="—" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource Ink}"/>
        </Border>
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" x:Name="AdviceDetail"
                   Text="正在连接本机 Codex" FontSize="12"
                   Foreground="{DynamicResource Muted}" Margin="0,5,0,0"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Top"/>
      </Grid>

      <Grid x:Name="LimitsPanel" Grid.Row="2" Margin="20,8,20,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition x:Name="QuotaGap" Width="12"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="FiveCard" Padding="15,13" CornerRadius="14"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
          <StackPanel x:Name="FiveLimitStack">
            <Grid x:Name="FiveLimitHeader" Height="55" Margin="0,0,0,7">
              <TextBlock x:Name="FiveTitle" Text="5 小时额度" FontSize="12"
                         Foreground="{DynamicResource Muted}" VerticalAlignment="Top"/>
              <TextBlock x:Name="FivePercent" Text="--%" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                         FontFamily="Segoe UI Variable Display" FontWeight="Bold" FontSize="33"
                         Foreground="{DynamicResource Accent}"/>
            </Grid>
            <ProgressBar x:Name="FiveProgress" Style="{StaticResource ThinProgress}" Maximum="100" Value="0"/>
            <TextBlock x:Name="FiveReset" Text="等待额度数据" FontSize="10.5"
                       Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>

        <Border x:Name="CompactDivider" Grid.Column="1" Width="1" Margin="5,0"
                Background="{DynamicResource Hairline}" Visibility="Collapsed"/>

        <Border x:Name="WeekCard" Grid.Column="2" Padding="15,13" CornerRadius="14"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
          <StackPanel x:Name="WeekLimitStack">
            <Grid x:Name="WeekLimitHeader" Height="55" Margin="0,0,0,7">
              <TextBlock x:Name="WeekTitle" Text="每周额度" FontSize="12"
                         Foreground="{DynamicResource Muted}" VerticalAlignment="Top"/>
              <TextBlock x:Name="WeekPercent" Text="--%" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                         FontFamily="Segoe UI Variable Display" FontWeight="Bold" FontSize="33"
                         Foreground="{DynamicResource Accent}"/>
            </Grid>
            <ProgressBar x:Name="WeekProgress" Style="{StaticResource ThinProgress}" Maximum="100" Value="0"/>
            <TextBlock x:Name="WeekReset" Text="等待额度数据" FontSize="10.5"
                       Foreground="{DynamicResource Muted}" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
      </Grid>

      <Grid x:Name="VerticalLimitsPanel" Grid.Row="2" Margin="10,5,10,4" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="5"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Center">
          <Grid Margin="0,0,0,2">
            <TextBlock Text="5 小时" FontSize="10.5" Foreground="{DynamicResource Muted}"/>
            <TextBlock Text="{Binding Text, ElementName=FivePercent}" HorizontalAlignment="Right"
                       FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource Ink}"/>
          </Grid>
          <TextBlock Text="{Binding Text, ElementName=FiveReset}" FontSize="9.5"
                     Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Border Grid.Row="1" Height="1" Background="{DynamicResource Hairline}" VerticalAlignment="Center"/>
        <StackPanel Grid.Row="2" VerticalAlignment="Center">
          <Grid Margin="0,0,0,2">
            <TextBlock Text="本周" FontSize="10.5" Foreground="{DynamicResource Muted}"/>
            <TextBlock Text="{Binding Text, ElementName=WeekPercent}" HorizontalAlignment="Right"
                       FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource Ink}"/>
          </Grid>
          <TextBlock Text="{Binding Text, ElementName=WeekReset}" FontSize="9.5"
                     Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="3" Margin="20,9,20,13">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#34C759" Margin="0,0,7,0"/>
          <TextBlock x:Name="SyncLabel" Text="正在连接…" FontSize="10.5"
                     Foreground="{DynamicResource Muted}"/>
        </StackPanel>
        <TextBlock x:Name="FooterLabel" Text="每 10 秒自动刷新" HorizontalAlignment="Right"
                   VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource FooterMuted}"/>
      </Grid>
    </Grid>
  </Border>
</Window>
